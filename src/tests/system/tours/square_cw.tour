# The clockwise square: mirror of square.tour (same 300 mm sides, same
# two planned stops on opposite legs) with every turn NEGATIVE omega.
#
# Why it exists: the rotation calibration carries SEPARATE gains for
# positive and negative turns (rotation_gain_pos / rotation_gain_neg), so
# a CCW-only square can never see a per-direction asymmetry. Run both
# squares; compare their closures.
#
# PLAYFIELD SIZING (2026-08-14). The original 700 mm square does not fit the
# camera table: the robot centre must stay inside +-611 x +-386 mm, and
# a 700 mm square driven from the centre reaches y = +700 mm. Sized here to run from the FIELD CENTRE with ~85 mm of margin
# on the tight (y) axis, which is more than the measured closure error,
# so a normal run cannot reach a rail.
#

MARK leg1a
TWIST vx=150 dist=150 timeout=6
STOP dwell=1.0
MARK leg1b
TWIST vx=150 dist=150 timeout=6
TWIST omega=-45 angle=90 timeout=8

MARK leg2
TWIST vx=150 dist=300 timeout=8
TWIST omega=-45 angle=90 timeout=8

MARK leg3a
TWIST vx=150 dist=150 timeout=6
STOP dwell=1.0
MARK leg3b
TWIST vx=150 dist=150 timeout=6
TWIST omega=-45 angle=90 timeout=8

MARK leg4
TWIST vx=150 dist=300 timeout=8
TWIST omega=-45 angle=90 timeout=8
STOP dwell=0.5

# Liveness is asserted by CAMFIX, not by SEND/EXPECT: protocol-v5 cleartext
# replies cannot be read back while binary telemetry streams (they interleave
# in one buffer and the line reader cannot separate them), so that EXPECT can
# never pass on hardware even though the robot answers.
# CW mirror: occupies 0..+300 in x and 0..-300 in y from its start, so it
# starts at (-150,+150) to sit centred. See square.tour for the reasoning.
CAMFIX x=0 y=0 radius=80 relative=1
