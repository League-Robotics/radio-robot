+def _assert_tuning(conn, proto, args) -> None:
+    """Push RAM-only tuning AFTER connecting -- which is the only moment
+    it can be pushed at all.
+
+    Opening this port RESETS the board (measured: uptime 29361 -> 34911 ms
+    held open, but ~4051 ms after a close/reopen, and suppressing DTR/RTS
+    does not prevent it). So every DBG:* and pid.* value set by a
+    DIFFERENT process is already gone by the time this one runs. Asserting
+    here, inside the process that then streams the profile, is what makes
+    a tuned measurement possible at all -- an earlier sweep set values
+    externally and unknowingly measured the boot defaults every time."""
+    def send_dbg(text: str) -> bool:
+        proto.tlmOff()          # binary TLM would bury the cleartext echo
+        time.sleep(0.4)
+        conn.read_pending_lines()
+        _DEBUG_LINES.clear()
+        conn.send_fast(f"DBG:{text}")
+        ok, deadline = False, time.monotonic() + 3.0
+        while time.monotonic() < deadline:
+            if any("applied" in line for line in _DEBUG_LINES):
+                ok = True
+                break
+            time.sleep(0.05)
+        proto.tlmOn()
+        time.sleep(1.0)
+        proto.read_pending_binary_tlm_frames()
+        return ok
+
+    if args.vmin is not None:
+        if not send_dbg(f"vmin {args.vmin}"):
+            raise RuntimeError(f"DBG:vmin {args.vmin} was not confirmed; "
+                               f"refusing to report a run whose floor is unknown")
+        print(f"  asserted: vMin {args.vmin} mm/s")
+
+    if args.asteady is not None:
+        if not send_dbg(f"asteady {args.asteady}"):
+            raise RuntimeError(f"DBG:asteady {args.asteady} was not confirmed; "
+                               f"refusing to report a run whose integrator gate "
+                               f"is unknown")
+        print(f"  asserted: aSteady {args.asteady} mm/s^2")
+
+    if args.poserr is not None:
+        if not send_dbg(f"pos {args.poserr}"):
+            raise RuntimeError(f"DBG:pos {args.poserr} was not confirmed")
+        print(f"  asserted: position-error clamp {args.poserr} mm")
+
+    if args.gain_left is not None or args.gain_right is not None:
+        # Both arms are always sent: the verb takes a PAIR and rewrites both
+        # wheels, so omitting one would silently reset it to 1.0 rather than
+        # leave it alone.
+        gl = args.gain_left if args.gain_left is not None else 1.0
+        gr = args.gain_right if args.gain_right is not None else 1.0
+        if not send_dbg(f"gain {gl} {gr}"):
+            raise RuntimeError(f"DBG:gain {gl} {gr} was not confirmed; "
+                               f"refusing to report a run whose wheel gains "
+                               f"are unknown")
+        print(f"  asserted: gain L {gl:.4f}  R {gr:.4f}")
+
+    gains = {}
+    for flag, key in (("pid_kp", "pid.kp"), ("pid_ki", "pid.ki"),
+                      ("pid_kff", "pid.kff"), ("pid_imax", "pid.iMax"),
+                      ("pid_kaw", "pid.kaw")):
+        val = getattr(args, flag, None)
+        if val is not None:
+            gains[key] = val
+    if gains:
+        # Fire-and-poll by design: a config's outcome rides the ack ring in
+        # a later telemetry push, so there is no synchronous reply here.
+        proto.config(**gains)
+        time.sleep(0.5)
+        print(f"  asserted: {gains}")
+
